{
  "name": "vendra",
  "version": "1.0.0",
  "description": "Vendra — collecte et analyse locales d'annonces (Electron + Playwright)",
  "main": "src/main/main.js",
  "productName": "Vendra",
  "appId": "com.vendra.app",
  "scripts": {
    "start": "electron --max-old-space-size=8192 .",
    "test": "node test/regression.test.js",
    "test:e2e": "node test/e2e.electron.test.js",
    "coverage": "c8 node test/regression.test.js",
    "browsers": "node tools/prepare-browsers.js",
    "browsers:win": "node tools/prepare-browsers.js --platform=win",
    "icon": "python3 tools/generate-icon.py",
    "prepack": "node tools/prepare-browsers.js",
    "pack": "electron-builder --dir",
    "predist": "node tools/prepare-browsers.js --platform=win",
    "dist": "electron-builder --win",
    "prebuild": "node tools/prepare-browsers.js --platform=win",
    "build": "electron-builder --win"
  },
  "dependencies": {
    "playwright": "^1.64.1"
  },
  "devDependencies": {
    "c8": "^12.0.0",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "extract-zip": "^2.0.1",
    "jsdom": "^30.1.2"
  },
  "build": {
    "appId": "com.vendra.app",
    "productName": "Vendra",
    "npmRebuild": false,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json",
      "node_modules/playwright/**/*",
      "node_modules/playwright-core/**/*",
      "!node_modules/playwright-core/.local-browsers/**/*"
    ],
    "extraResources": [
      {
        "from": "node_modules/playwright-core/.local-browsers",
        "to": "browsers",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Vendra",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "Vendra-Portable-${version}.exe"
    }
  }
}
